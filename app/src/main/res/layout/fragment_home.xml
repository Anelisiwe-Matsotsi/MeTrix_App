<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/frameLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HomeFragment">

    <!-- Background -->
    <ImageView
        android:id="@+id/imageView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"
        android:src="@drawable/img_6" />

    <!-- ======================================================== -->
    <!-- BODY / CLOTHING                                          -->
    <!-- ======================================================== -->

    <!-- BODY -->
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="381dp"
        android:layout_height="786dp"
        android:src="@drawable/base_body_f"
        tools:layout_editor_absoluteX="25dp"
        tools:layout_editor_absoluteY="92dp" />

    <!-- TOP -->
    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="381dp"
        android:layout_height="775dp"
        android:layout_marginTop="4dp"
        android:src="@drawable/top2"
        tools:layout_editor_absoluteX="25dp"
        tools:layout_editor_absoluteY="96dp" />

    <!-- BOTTOM -->
    <ImageView
        android:id="@+id/imageView5"
        android:layout_width="381dp"
        android:layout_height="770dp"
        android:layout_marginStart="1dp"
        android:layout_marginTop="9dp"
        android:layout_marginEnd="5dp"
        android:layout_marginBottom="9dp"
        android:src="@drawable/bottom2"
        tools:layout_editor_absoluteX="26dp"
        tools:layout_editor_absoluteY="101dp" />

    <!-- ======================================================== -->
    <!-- FACIAL FEATURES                                          -->
    <!-- ======================================================== -->

    <!-- EYELASHES -->
    <ImageView
        android:id="@+id/imageView8"
        android:layout_width="383dp"
        android:layout_height="781dp"
        android:layout_marginStart="-2dp"
        android:layout_marginTop="-2dp"
        android:src="@drawable/lash_1"
        tools:layout_editor_absoluteX="23dp"
        tools:layout_editor_absoluteY="90dp" />

    <!-- NOSE -->
    <ImageView
        android:id="@+id/imageView9"
        android:layout_width="378dp"
        android:layout_height="779dp"
        android:layout_marginTop="2dp"
        android:src="@drawable/nose_2"
        tools:layout_editor_absoluteX="25dp"
        tools:layout_editor_absoluteY="94dp" />

    <!-- BASE EYES -->
    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="382dp"
        android:layout_height="777dp"
        android:layout_marginStart="-3dp"
        android:src="@drawable/base_white_eyes"
        tools:layout_editor_absoluteX="22dp"
        tools:layout_editor_absoluteY="92dp" />

    <!-- EYE LASH OVERLAY -->
    <ImageView
        android:id="@+id/imageView6"
        android:layout_width="385dp"
        android:layout_height="783dp"
        android:layout_marginStart="-4dp"
        android:layout_marginTop="-1dp"
        android:src="@drawable/eyes_lashes1"
        app:tint="#D1310505"
        tools:layout_editor_absoluteX="21dp"
        tools:layout_editor_absoluteY="91dp" />

    <!-- PUPILS -->
    <ImageView
        android:id="@+id/imageView7"
        android:layout_width="384dp"
        android:layout_height="786dp"
        android:layout_marginStart="-4dp"
        android:layout_marginTop="-4dp"
        android:src="@drawable/eye1c"
        app:tint="#C5350808"
        tools:layout_editor_absoluteX="21dp"
        tools:layout_editor_absoluteY="88dp" />

    <!-- MOUTH -->
    <ImageView
        android:id="@+id/imageView10"
        android:layout_width="378dp"
        android:layout_height="777dp"
        android:layout_marginStart="-1dp"
        android:layout_marginTop="5dp"
        android:src="@drawable/mouth_9"
        android:visibility="invisible"
        tools:layout_editor_absoluteX="24dp"
        tools:layout_editor_absoluteY="97dp" />

    <!-- EYEBROWS -->
    <ImageView
        android:id="@+id/imageView11"
        android:layout_width="271dp"
        android:layout_height="253dp"
        android:layout_marginStart="55dp"
        android:layout_marginTop="93dp"
        android:src="@drawable/neutro_eyebrows1"
        tools:layout_editor_absoluteX="80dp"
        tools:layout_editor_absoluteY="185dp" />

    <!-- GRIN MOUTH -->
    <ImageView
        android:id="@+id/imageView14"
        android:layout_width="277dp"
        android:layout_height="251dp"
        android:layout_marginStart="50dp"
        android:layout_marginTop="96dp"
        android:src="@drawable/grin_mouth"
        tools:layout_editor_absoluteX="75dp"
        tools:layout_editor_absoluteY="188dp" />

    <!-- LIPSTICK -->
    <ImageView
        android:id="@+id/imageView15"
        android:layout_width="285dp"
        android:layout_height="241dp"
        android:layout_marginStart="47dp"
        android:layout_marginTop="101dp"
        android:src="@drawable/lipstick6_grin"
        tools:layout_editor_absoluteX="72dp"
        tools:layout_editor_absoluteY="193dp" />

    <!-- ======================================================== -->
    <!-- HAIR                                                     -->
    <!-- ======================================================== -->

    <!-- MAIN HAIR -->
    <ImageView
        android:id="@+id/imageView12"
        android:layout_width="283dp"
        android:layout_height="242dp"
        android:layout_marginStart="47dp"
        android:layout_marginTop="96dp"
        android:src="@drawable/hair_1"
        app:tint="#101010"
        tools:layout_editor_absoluteX="72dp"
        tools:layout_editor_absoluteY="188dp" />

    <!-- HAIR EXTENSION -->
    <ImageView
        android:id="@+id/imageView13"
        android:layout_width="283dp"
        android:layout_height="236dp"
        android:layout_marginStart="50dp"
        android:layout_marginTop="99dp"
        android:src="@drawable/extention_hair"
        android:visibility="visible"
        app:tint="#101010"
        tools:layout_editor_absoluteX="75dp"
        tools:layout_editor_absoluteY="191dp" />

    <!-- ======================================================== -->
    <!-- CLOTHING / ACCESSORIES                                   -->
    <!-- ======================================================== -->

    <ImageView
        android:id="@+id/imageView17"
        android:layout_width="270dp"
        android:layout_height="390dp"
        android:src="@drawable/dress_real"
        tools:layout_editor_absoluteX="80dp"
        tools:layout_editor_absoluteY="311dp" />

    <ImageView
        android:id="@+id/imageView18"
        android:layout_width="378dp"
        android:layout_height="790dp"
        android:src="@drawable/shoe_4"
        tools:layout_editor_absoluteX="25dp"
        tools:layout_editor_absoluteY="92dp" />

    <!-- ======================================================== -->
    <!-- AVATAR OPTION CARDS                                      -->
    <!-- ======================================================== -->

    <FrameLayout
        android:id="@+id/card6"
        android:layout_width="61dp"
        android:layout_height="69dp"
        tools:layout_editor_absoluteX="290dp"
        tools:layout_editor_absoluteY="651dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/card_glass_border"
            android:padding="6dp">

            <ImageView
                android:id="@+id/imgItem6"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/base_body_g" />

        </RelativeLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/card5"
        android:layout_width="61dp"
        android:layout_height="69dp"
        tools:layout_editor_absoluteX="350dp"
        tools:layout_editor_absoluteY="411dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/card_glass_border"
            android:padding="6dp">

            <ImageView
                android:id="@+id/imgItem5"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:tint="#3E0606"
                app:srcCompat="@drawable/local_drink_40px" />

        </RelativeLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>