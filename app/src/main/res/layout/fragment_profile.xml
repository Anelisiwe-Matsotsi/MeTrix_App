<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/frameLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/img_1"
    tools:context=".profileFragment">

    <!-- Character Base Layer -->
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/base_body_f"
        app:layout_constraintBottom_toBottomOf="@+id/imageView2"
        app:layout_constraintEnd_toEndOf="@+id/imageView5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="381dp"
        android:layout_height="775dp"
        android:layout_marginTop="4dp"
        android:src="@drawable/bra"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imageView5"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="2dp"
        android:layout_marginTop="9dp"
        android:layout_marginEnd="5dp"
        android:layout_marginBottom="9dp"
        android:src="@drawable/slip"
        app:layout_constraintBottom_toBottomOf="@+id/imageView2"
        app:layout_constraintEnd_toEndOf="@+id/imageView2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/imageView" />

    <!-- Left Profile Card -->
    <LinearLayout
        android:id="@+id/profileCard"
        android:layout_width="120dp"
        android:layout_height="160dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="48dp"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardBackgroundColor="#431F1F">

            <androidx.cardview.widget.CardView
                android:layout_width="104dp"
                android:layout_height="144dp"
                android:layout_gravity="center"
                app:cardBackgroundColor="#69F0EAEA">

                <TextView
                    android:id="@+id/textView2"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:fontFamily="@font/robotoslab_extrabold"
                    android:gravity="center"
                    android:text="Natty"
                    android:textAllCaps="true"
                    android:textAppearance="@style/TextAppearance.AppCompat.Large"
                    android:textStyle="italic" />
            </androidx.cardview.widget.CardView>
        </androidx.cardview.widget.CardView>
    </LinearLayout>


    <!-- ======================================================== -->
    <!-- RIGHT SIDE 2-COLUMN GRID (FIXED CONSTRAINTS)            -->
    <!-- ======================================================== -->

    <!-- ROW 1 -->
    <FrameLayout
        android:id="@+id/card1"
        android:layout_width="61dp"
        android:layout_height="69dp"
        android:layout_marginTop="64dp"
        android:layout_marginEnd="85dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/card_glass_border"
            android:padding="6dp">

            <ImageView
                android:id="@+id/imgItem1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/base_body_e" />
        </RelativeLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/card2"
        android:layout_width="61dp"
        android:layout_height="69dp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/card1"
        app:layout_constraintTop_toTopOf="@id/card1">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/card_glass_border"
            android:padding="6dp">

            <ImageView
                android:id="@+id/imgItem2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/base_body_v" />
        </RelativeLayout>
    </FrameLayout>

    <!-- ROW 2 -->
    <FrameLayout
        android:id="@+id/card3"
        android:layout_width="61dp"
        android:layout_height="69dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="@id/card1"
        app:layout_constraintTop_toBottomOf="@id/card1">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/card_glass_border"
            android:padding="6dp">

            <ImageView
                android:id="@+id/imgItem3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/base_body_b" />
        </RelativeLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/card4"
        android:layout_width="61dp"
        android:layout_height="69dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="@id/card2"
        app:layout_constraintTop_toBottomOf="@id/card2">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/card_glass_border"
            android:padding="6dp">

            <ImageView
                android:id="@+id/imgItem4"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/base_body_m" />
        </RelativeLayout>
    </FrameLayout>

    <!-- ROW 3 -->
    <FrameLayout
        android:id="@+id/card5"
        android:layout_width="61dp"
        android:layout_height="69dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="@id/card3"
        app:layout_constraintTop_toBottomOf="@id/card3">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/card_glass_border"
            android:padding="6dp">

            <ImageView
                android:id="@+id/imgItem5"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/base_body_c" />
        </RelativeLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/card6"
        android:layout_width="61dp"
        android:layout_height="69dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="@id/card4"
        app:layout_constraintTop_toBottomOf="@id/card4">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/card_glass_border"
            android:padding="6dp">

            <ImageView
                android:id="@+id/imgItem6"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/base_body_g" />
        </RelativeLayout>
    </FrameLayout>

    <!-- ROW 4 -->
    <FrameLayout
        android:id="@+id/card7"
        android:layout_width="61dp"
        android:layout_height="69dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="@id/card5"
        app:layout_constraintTop_toBottomOf="@id/card5">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/card_glass_border"
            android:padding="6dp">

            <ImageView
                android:id="@+id/imgItem7"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/base_body_h" />
        </RelativeLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/card8"
        android:layout_width="61dp"
        android:layout_height="69dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="@id/card6"
        app:layout_constraintTop_toBottomOf="@id/card6">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/card_glass_border"
            android:padding="6dp">

            <ImageView
                android:id="@+id/imgItem8"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/base_body_q" />
        </RelativeLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>