<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/frameLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/img_1"
    tools:context=".profileFragment">


    <!-- ======================================================== -->
    <!-- AVATAR BASE LAYERS                                       -->
    <!-- ======================================================== -->

    <!-- Character base body -->
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/base_body_f"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@+id/imageView2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/imageView5" />

    <!-- Character top/clothing layer -->
    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="381dp"
        android:layout_height="775dp"
        android:layout_marginTop="4dp"
        android:src="@drawable/top2"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Character bottom/clothing layer -->
    <ImageView
        android:id="@+id/imageView5"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="2dp"
        android:layout_marginTop="9dp"
        android:layout_marginEnd="5dp"
        android:layout_marginBottom="9dp"
        android:src="@drawable/bottom2"
        app:layout_constraintTop_toTopOf="@+id/imageView"
        app:layout_constraintBottom_toBottomOf="@+id/imageView2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/imageView2" />


    <!-- ======================================================== -->
    <!-- LEFT PROFILE CARD                                        -->
    <!-- ======================================================== -->

    <LinearLayout
        android:id="@+id/profileCard"
        android:layout_width="153dp"
        android:layout_height="149dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="48dp"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Outer card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardBackgroundColor="#431F1F">

            <!-- Inner card -->
            <androidx.cardview.widget.CardView
                android:layout_width="139dp"
                android:layout_height="127dp"
                android:layout_gravity="center"
                app:cardBackgroundColor="#69F0EAEA">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <!-- Profile icon -->
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginBottom="2dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/account_box_40px" />

                    <!-- Profile name -->
                    <TextView
                        android:id="@+id/textView2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:fontFamily="@font/robotoslab_extrabold"
                        android:text="Natty"
                        android:textAlignment="center"
                        android:textAllCaps="true"
                        android:textAppearance="@style/TextAppearance.AppCompat.Large"
                        android:textSize="16sp"
                        android:textStyle="italic" />

                    <!-- Personality -->
                    <TextView
                        android:id="@+id/tvPersonality"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/robotoslab_medium"
                        android:text="Personality: Curious"
                        android:textSize="11sp" />

                    <!-- Birthday -->
                    <TextView
                        android:id="@+id/tvBirthday"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/robotoslab_medium"
                        android:text="Birthday: 15/09/2003"
                        android:textSize="11sp" />

                    <!-- Aspiration -->
                    <TextView
                        android:id="@+id/tvAspiration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/robotoslab_medium"
                        android:text="Aspiration: To be rich"
                        android:textSize="11sp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </androidx.cardview.widget.CardView>
    </LinearLayout>


    <!-- ======================================================== -->
    <!-- RIGHT SIDE HAIR SELECTION GRID                           -->
    <!-- ======================================================== -->

    <!-- ROW 1 -->

    <FrameLayout
        android:id="@+id/card1"
        android:layout_width="61dp"
        android:layout_height="69dp"
        android:layout_marginTop="64dp"
        android:layout_marginEnd="85dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/card_glass_border"
            android:padding="6dp">

            <ImageView
                android:id="@+id/imgItem1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/hair_1" />

        </RelativeLayout>
    </FrameLayout>


    <FrameLayout
        android:id="@+id/card2"
        android:layout_width="61dp"
        android:layout_height="69dp"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toTopOf="@id/card1"
        app:layout_constraintStart_toEndOf="@id/card1">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/card_glass_border"
            android:padding="6dp">

            <ImageView
                android:id="@+id/imgItem2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/extention_hair" />

        </RelativeLayout>
    </FrameLayout>


    <!-- ROW 2 -->

    <FrameLayout
        android:id="@+id/card3"
        android:layout_width="61dp"
        android:layout_height="69dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/card1"
        app:layout_constraintStart_toStartOf="@id/card1">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/card_glass_border"
            android:padding="6dp">

            <ImageView
                android:id="@+id/imgItem3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/hair_3" />

        </RelativeLayout>
    </FrameLayout>


    <FrameLayout
        android:id="@+id/card4"
        android:layout_width="61dp"
        android:layout_height="69dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/card2"
        app:layout_constraintStart_toStartOf="@id/card2">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/card_glass_border"
            android:padding="6dp">

            <ImageView
                android:id="@+id/imgItem4"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/hair_bun" />

        </RelativeLayout>
    </FrameLayout>


    <!-- ROW 3 -->

    <FrameLayout
        android:id="@+id/card5"
        android:layout_width="61dp"
        android:layout_height="69dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/card3"
        app:layout_constraintStart_toStartOf="@id/card3">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/card_glass_border"
            android:padding="6dp">

            <ImageView
                android:id="@+id/imgItem5"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/hair_5" />

        </RelativeLayout>
    </FrameLayout>


    <FrameLayout
        android:id="@+id/card6"
        android:layout_width="61dp"
        android:layout_height="69dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/card4"
        app:layout_constraintStart_toStartOf="@id/card4">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/card_glass_border"
            android:padding="6dp">

            <ImageView
                android:id="@+id/imgItem6"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/pony_hair" />

        </RelativeLayout>
    </FrameLayout>


    <!-- ROW 4 -->

    <FrameLayout
        android:id="@+id/card7"
        android:layout_width="61dp"
        android:layout_height="69dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/card5"
        app:layout_constraintStart_toStartOf="@id/card5">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/card_glass_border"
            android:padding="6dp">

            <ImageView
                android:id="@+id/imgItem7"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/hair_4" />

        </RelativeLayout>
    </FrameLayout>


    <FrameLayout
        android:id="@+id/card8"
        android:layout_width="61dp"
        android:layout_height="69dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/card6"
        app:layout_constraintStart_toStartOf="@id/card6">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/card_glass_border"
            android:padding="6dp">

            <ImageView
                android:id="@+id/imgItem8"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/strips_hair" />

        </RelativeLayout>
    </FrameLayout>


    <!-- ======================================================== -->
    <!-- AVATAR NAVIGATION BUTTONS                                -->
    <!-- ======================================================== -->

    <!-- Right arrow -->
    <ImageButton
        android:id="@+id/imageButton2"
        android:layout_width="63dp"
        android:layout_height="73dp"
        android:layout_marginStart="271dp"
        android:layout_marginTop="423dp"
        android:background="#60FFFFFF"
        android:scaleType="fitCenter"
        android:scaleX="@android:dimen/app_icon_size"
        android:src="@drawable/arrow_right_45dp_8"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Left arrow -->
    <ImageButton
        android:id="@+id/imageButton"
        android:layout_width="63dp"
        android:layout_height="73dp"
        android:layout_marginTop="423dp"
        android:layout_marginEnd="315dp"
        android:background="#60FFFFFF"
        android:scaleType="fitCenter"
        android:scaleX="@android:dimen/app_icon_size"
        android:src="@drawable/arrow_left_45dp_8"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ======================================================== -->
    <!-- AVATAR FACIAL FEATURE LAYERS                             -->
    <!-- ======================================================== -->

    <!-- Eyelashes -->
    <ImageView
        android:id="@+id/imageView8"
        android:layout_width="383dp"
        android:layout_height="781dp"
        android:src="@drawable/lash_1"
        tools:layout_editor_absoluteX="-2dp"
        tools:layout_editor_absoluteY="-2dp" />

    <!-- Nose -->
    <ImageView
        android:id="@+id/imageView9"
        android:layout_width="378dp"
        android:layout_height="779dp"
        android:src="@drawable/nose_2"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="2dp" />

    <!-- Mouth -->
    <ImageView
        android:id="@+id/imageView10"
        android:layout_width="378dp"
        android:layout_height="777dp"
        android:src="@drawable/mouth_9"
        android:visibility="invisible"
        tools:layout_editor_absoluteX="-1dp"
        tools:layout_editor_absoluteY="5dp" />

    <!-- Eyebrows -->
    <ImageView
        android:id="@+id/imageView11"
        android:layout_width="271dp"
        android:layout_height="253dp"
        android:src="@drawable/neutro_eyebrows1"
        tools:layout_editor_absoluteX="55dp"
        tools:layout_editor_absoluteY="93dp" />

    <!-- Main hair -->
    <ImageView
        android:id="@+id/imageView12"
        android:layout_width="283dp"
        android:layout_height="242dp"
        android:src="@drawable/hair_1"
        android:tint="#101010"
        tools:layout_editor_absoluteX="47dp"
        tools:layout_editor_absoluteY="96dp" />

    <!-- Hair extension -->
    <ImageView
        android:id="@+id/imageView13"
        android:layout_width="283dp"
        android:layout_height="236dp"
        android:src="@drawable/extention_hair"
        android:tint="#101010"
        android:visibility="visible"
        tools:layout_editor_absoluteX="50dp"
        tools:layout_editor_absoluteY="99dp" />

    <!-- Base eyes -->
    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="382dp"
        android:layout_height="777dp"
        android:src="@drawable/base_white_eyes"
        tools:layout_editor_absoluteX="-3dp"
        tools:layout_editor_absoluteY="0dp" />

    <!-- Eyelashes / eye overlay -->
    <ImageView
        android:id="@+id/imageView6"
        android:layout_width="385dp"
        android:layout_height="783dp"
        android:src="@drawable/eyes_lashes1"
        android:tint="#D1310505"
        tools:layout_editor_absoluteX="-4dp"
        tools:layout_editor_absoluteY="-1dp" />

    <!-- Pupil / eye colour -->
    <ImageView
        android:id="@+id/imageView7"
        android:layout_width="384dp"
        android:layout_height="786dp"
        android:src="@drawable/eye1c"
        android:tint="#B7240C0C"
        tools:layout_editor_absoluteX="-4dp"
        tools:layout_editor_absoluteY="-4dp" />

    <!-- Grin mouth -->
    <ImageView
        android:id="@+id/imageView14"
        android:layout_width="277dp"
        android:layout_height="251dp"
        android:src="@drawable/grin_mouth"
        tools:layout_editor_absoluteX="50dp"
        tools:layout_editor_absoluteY="96dp" />

    <!-- Lipstick -->
    <ImageView
        android:id="@+id/imageView15"
        android:layout_width="285dp"
        android:layout_height="241dp"
        android:src="@drawable/lipstick6_grin"
        tools:layout_editor_absoluteX="47dp"
        tools:layout_editor_absoluteY="101dp" />


    <!-- ======================================================== -->
    <!-- AVATAR CUSTOMIZATION CATEGORY BUTTONS                    -->
    <!-- ======================================================== -->

    <!-- Hair -->
    <ImageButton
        android:id="@+id/imageButton3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/card_glass_border"
        android:src="@drawable/self_care_24px"
        tools:layout_editor_absoluteX="285dp"
        tools:layout_editor_absoluteY="24dp" />

    <!-- Eyes -->
    <ImageButton
        android:id="@+id/imageButton4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/card_glass_border"
        android:src="@drawable/visibility_24px"
        tools:layout_editor_absoluteX="326dp"
        tools:layout_editor_absoluteY="24dp" />

    <!-- Lips -->
    <ImageButton
        android:id="@+id/imageButton5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/card_glass_border"
        android:src="@drawable/lips_24px"
        tools:layout_editor_absoluteX="361dp"
        tools:layout_editor_absoluteY="24dp" />

</androidx.constraintlayout.widget.ConstraintLayout>