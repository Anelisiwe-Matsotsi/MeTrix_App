<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D6C4B5">


    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginVertical="28dp"
        app:cardBackgroundColor="#FAF7F2"
        app:cardCornerRadius="32dp"
        app:cardElevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:fontFamily="@font/robotoslab_extrabold"
                    android:letterSpacing="0.05"
                    android:text="✦ SET UP YOUR PROFILE"
                    android:textColor="#7A6A65"
                    android:textSize="11sp" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:fontFamily="@font/robotoslab_extrabold"
                    android:text="Choose your girly"
                    android:textColor="#43302E"
                    android:textSize="18sp" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/card_glass_border"
                    android:backgroundTint="#F2EDE4"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/robotoslab_medium"
                        android:text="🧍‍♀️ [ Tap to Choose Avatar ]"
                        android:textColor="#7A6A65"
                        android:textSize="13sp" />
                </LinearLayout>


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:fontFamily="@font/robotoslab_extrabold"
                    android:text="Personality"
                    android:textColor="#43302E"
                    android:textSize="18sp" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:columnCount="2"
                    android:rowCount="2">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:background="#EFE5DE"
                        android:fontFamily="@font/robotoslab_medium"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:text="🌸 Chic &amp; Minimal"
                        android:textColor="#5A3A35"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:background="#F2EDE4"
                        android:fontFamily="@font/robotoslab_medium"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:text="☕️ Cozy Creative"
                        android:textColor="#7A544E"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:background="#F2EDE4"
                        android:fontFamily="@font/robotoslab_medium"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:text="✨ Bold Trendsetter"
                        android:textColor="#7A544E"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:background="#F2EDE4"
                        android:fontFamily="@font/robotoslab_medium"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:text="🌿 Eco Minimalist"
                        android:textColor="#7A544E"
                        android:textSize="12sp" />
                </GridLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:fontFamily="@font/robotoslab_extrabold"
                    android:text="Aspirations"
                    android:textColor="#43302E"
                    android:textSize="18sp" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:columnCount="2">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:background="#F2EDE4"
                        android:fontFamily="@font/robotoslab_medium"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:text="🎯 Build Capsule \nWardrobe"
                        android:textColor="#7A544E"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:background="#F2EDE4"
                        android:fontFamily="@font/robotoslab_medium"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:text="🧘 Daily \nMindfulness"
                        android:textColor="#7A544E"
                        android:textSize="12sp" />
                </GridLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:fontFamily="@font/robotoslab_extrabold"
                    android:text="Your Name"
                    android:textColor="#43302E"
                    android:textSize="18sp" />

                <EditText
                    android:id="@+id/etOnboardName"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="32dp"
                    android:background="@drawable/card_glass_border"
                    android:backgroundTint="#F2EDE4"
                    android:fontFamily="@font/robotoslab_medium"
                    android:hint="Type your name..."
                    android:inputType="textPersonName"
                    android:paddingHorizontal="16dp"
                    android:textColor="#43302E"
                    android:textColorHint="#A08C86"
                    android:textSize="14sp" />


                <Button
                    android:id="@+id/btnOnboardNext"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:backgroundTint="#43302E"
                    android:fontFamily="@font/robotoslab_extrabold"
                    android:text="Let's Begin ➔"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    app:cornerRadius="16dp" />

            </LinearLayout>
        </ScrollView>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>